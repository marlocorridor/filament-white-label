{
    "name": "muazzambuilds/filament-white-label",
    "description": "Total panel white-label for Filament v5 — brand, colors, fonts, layout, CSS, footer. Per panel and optional per tenant.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "white-label",
        "branding",
        "theme",
        "settings"
    ],
    "homepage": "https://github.com/muazzambuilds/filament-white-label",
    "license": "MIT",
    "authors": [
        {
            "name": "Muazzam Builds",
            "email": "me@muazzamalikhan.com",
            "homepage": "https://github.com/muazzambuilds"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MuazzamBuilds\\FilamentWhiteLabel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MuazzamBuilds\\FilamentWhiteLabel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MuazzamBuilds\\FilamentWhiteLabel\\FilamentWhiteLabelServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
